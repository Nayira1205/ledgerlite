# Copy this file to .env and adjust. .env is git-ignored; this example file is safe to commit.
# Never put real secrets in THIS file.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Demo funding adds SIMULATED money. Keep false unless you want the demo-funds endpoint enabled.
DEMO_MODE=true

# Browser origins allowed to call the API (comma-separated). Used later by the React UI.
CORS_ORIGINS=http://localhost:5173

# Local MongoDB replica set started by `npm run db:up` (see docker-compose.yml).
MONGODB_URI=mongodb://localhost:27017/ledgerlite?replicaSet=rs0

# REQUIRED. Must be at least 32 characters. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never commit the real value. The placeholder below is too short on purpose,
# so the app refuses to start until you replace it in your own .env.
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=1h

# bcrypt cost (12 is a good default; each +1 doubles the hashing time)
BCRYPT_ROUNDS=12

# Added in later milestones (do not fill in yet):
# REDIS_URL=
# RABBITMQ_URL=
